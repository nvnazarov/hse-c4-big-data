connector.name=iceberg
iceberg.catalog.type=hive_metastore
hive.metastore.uri=thrift://${HA5__HIVE_METASTORE__HOST_NAME}:${HA5__HIVE_METASTORE__PORT}
fs.native-s3.enabled=true
s3.endpoint=http://${HA5__MINIO__HOST_NAME}:${HA5__MINIO__API__PORT}
s3.region=us-east-1
s3.path-style-access=true
s3.aws-access-key=${HA5__MINIO__USER}
s3.aws-secret-key=${HA5__MINIO__PASSWORD}
iceberg.file-format=PARQUET
